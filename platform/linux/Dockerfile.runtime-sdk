FROM rockylinux:8@sha256:9794037624aaa6212aeada1d28861ef5e0a935adaf93e4ef79837119f2a2d04c AS builddeps

# Keep this layer independent of the SDK recipe and its optional cache seed.
RUN dnf -y upgrade ca-certificates \
    && update-ca-trust \
    && dnf -y --setopt=install_weak_deps=False --enablerepo=powertools install \
        gcc-toolset-12-gcc-c++ cmake ninja-build make perl python3 pkgconf-pkg-config \
        curl tar xz bzip2 gzip patch file binutils findutils which \
        libxcb-devel xcb-util-image-devel xcb-util-keysyms-devel \
        xcb-util-renderutil-devel xcb-util-wm-devel libxkbcommon-x11-devel \
        mesa-libGL-devel mesa-libEGL-devel libglvnd-devel fontconfig-devel freetype-devel \
        dbus-devel zlib-devel libX11-devel libX11-xcb libXext-devel \
        libXrender-devel libXi-devel libSM-devel libICE-devel libxkbcommon-devel \
        libXfixes-devel libXrandr-devel libXcursor-devel libXinerama-devel \
        bison flex gperf expat-devel \
    && dnf clean all

FROM builddeps AS runtime-sdk

ARG DAYLINE_SDK_RECIPE
LABEL org.opencontainers.image.source="https://github.com/noxmew/dayline" \
      io.dayline.sdk.recipe="${DAYLINE_SDK_RECIPE}"

ENV SDK_PREFIX=/sdk/prefix \
    SDK_WORKDIR=/tmp/dayline-runtime-build

# The default context contains scripts only; the named context contains only
# an optional, secret-free SDK prefix restored from the existing Actions cache.
COPY build-runtime-sdk.sh /usr/local/libexec/dayline/build-runtime-sdk.sh
COPY --from=sdkseed / /sdk/prefix/

# BuildKit does not create Docker's marker file. This RUN already executes in
# the isolated build container required by the unchanged SDK script.
RUN test -n "$DAYLINE_SDK_RECIPE" \
    && touch /.dockerenv \
    && bash /usr/local/libexec/dayline/build-runtime-sdk.sh \
    && rm -rf "$SDK_WORKDIR"
